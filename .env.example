# Database
DB_URL=jdbc:mysql://localhost:3306/ai_exam_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver
JPA_DDL_AUTO=update

# JWT
APP_JWT_SECRET=replace-with-a-long-random-secret-min-64-chars
APP_JWT_ACCESS_EXPIRATION=86400000
APP_JWT_REFRESH_EXPIRATION=604800000

# Local bootstrap users
APP_BOOTSTRAP_DEMO_ENABLED=true
APP_BOOTSTRAP_DEMO_ADMIN_EMAIL=admin@ai-exam.local
APP_BOOTSTRAP_DEMO_ADMIN_PASSWORD=Admin@123456
APP_BOOTSTRAP_DEMO_ADMIN_NAME=Platform Admin
APP_BOOTSTRAP_DEMO_TEACHER_EMAIL=teacher@ai-exam.local
APP_BOOTSTRAP_DEMO_TEACHER_PASSWORD=Teacher@123456
APP_BOOTSTRAP_DEMO_TEACHER_NAME=Demo Teacher
APP_BOOTSTRAP_DEMO_TEACHER_EMPLOYEE_ID=TCH-1001
APP_BOOTSTRAP_DEMO_STUDENT_EMAIL=student@ai-exam.local
APP_BOOTSTRAP_DEMO_STUDENT_PASSWORD=Student@123456
APP_BOOTSTRAP_DEMO_STUDENT_NAME=Demo Student

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_EMAIL_ENABLED=true
APP_EMAIL_FROM_NAME=AI Exam System
APP_EMAIL_SUPPORT=support@ai-exam-system.local

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*

# Frontend URLs
APP_FRONTEND_BASE_URL=http://localhost:8080
APP_FRONTEND_RESET_URL=http://localhost:8080/pages/reset-password.html
